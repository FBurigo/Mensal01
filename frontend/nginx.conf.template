# Configuração do Nginx do frontend.
#
# Este arquivo é um template: a imagem oficial do Nginx aplica `envsubst` nos
# arquivos de /etc/nginx/templates e grava o resultado em
# /etc/nginx/conf.d/default.conf antes de iniciar o servidor.
#
# Variáveis substituídas no start do container (com padrão definido no
# Dockerfile): ${BACKEND_HOST}, ${BACKEND_PORT} e ${NGINX_RESOLVER}.
# As demais ($host, $request_uri, ...) são variáveis do próprio Nginx e são
# preservadas — o filtro NGINX_ENVSUBST_FILTER garante isso.

server {
    listen 80;
    listen [::]:80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # O endereço do backend é resolvido a cada requisição, e não no start.
    # Sem isso o Nginx recusa-se a iniciar quando o container do backend ainda
    # não existe ("host not found in upstream"), impedindo que a imagem
    # publicada seja baixada e iniciada de forma isolada para verificação.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 3s;
    set $backend_upstream "${BACKEND_HOST}:${BACKEND_PORT}";

    include /etc/nginx/snippets/security-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Verificação de vida do próprio container, sem depender do backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
        return 200 "ok\n";
    }

    # Versão da imagem do frontend: gravada no build a partir do SHA do commit.
    location = /version.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # A documentação do FastAPI carrega o Swagger UI de uma CDN e precisa de uma
    # CSP própria, por isso tem um bloco separado.
    location = /api/docs {
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: https://fastapi.tiangolo.com; style-src 'self' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    }

    # `^~` garante prioridade sobre o bloco de cache de estáticos (expressão
    # regular), para que nenhuma rota da API seja servida como arquivo.
    # `$request_uri` preserva o caminho completo e a query string
    # (ex.: /api/books?q=hobbit&reading_status=LENDO).
    location ^~ /api/ {
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Sem `expires` aqui: a diretiva emitiria um segundo Cache-Control,
    # duplicando o cabeçalho na resposta.
    location ~* \.(css|js|svg|png|jpg|jpeg|webp)$ {
        add_header Cache-Control "public, max-age=3600" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
